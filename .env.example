# 复制方式：不要手抄，运行 bash scripts/gen-env.sh 自动生成 .env。
# .env 只存在本机，已被 .gitignore 忽略；绝不提交，也不设成 Ubuntu 全局环境变量。

# 网关管理员密钥，以 sk- 开头。可以轮换。
LITELLM_MASTER_KEY=sk-change-me
# 加密数据库内凭据。生成后永不更改。
LITELLM_SALT_KEY=sk-change-me
# Postgres 密码（十六进制字符）
POSTGRES_PASSWORD=change-me
# GitHub Models 细粒度 PAT，只授 Models 只读。不要命名为 GITHUB_TOKEN/GH_TOKEN（Copilot CLI 和 gh 会读取它们）。
GITHUB_MODELS_TOKEN=
