[1.849657, "o", "\r\n\u001b[1;36m━━ Scene 5/9 · Rate limit ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n   \u001b[2mWhy     \u001b[0m: \u001b[2mOne noisy app cannot starve the others.\u001b[0m\r\n   \u001b[2mExpect  \u001b[0m: demo-ratelimit (5 requests/minute): requests 1–5 → 200, request 6 → 429\r\n"]
