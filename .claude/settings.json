{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose:*)",
      "Bash(docker inspect:*)",
      "Bash(docker logs:*)",
      "Bash(docker ps:*)",
      "Bash(docker port:*)",
      "Bash(docker pull:*)",
      "Bash(docker image inspect:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(python3 scripts/p1check.py:*)",
      "Bash(bash scripts/pin-image.sh:*)",
      "Bash(bash scripts/pull-models.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git reset:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume prune:*)",
      "Read(./.env)"
    ]
  }
}
